{
  "name": "raccoon-studio",
  "version": "0.1.3",
  "private": true,
  "description": "Raccoon Studio — local-first Windows subtitle editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoazMao/Raccoon-Studio.git"
  },
  "homepage": "https://github.com/BoazMao/Raccoon-Studio#readme",
  "bugs": {
    "url": "https://github.com/BoazMao/Raccoon-Studio/issues"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.cjs",
    "test:translation": "node scripts/translation-e2e.cjs",
    "test:download": "node scripts/download-quality-e2e.cjs",
    "test:audio": "node scripts/audio-e2e.cjs",
    "test:pipeline": "node scripts/pipeline.cjs",
    "test:install": "node scripts/install-smoke.cjs",
    "test:gpu": "node scripts/gpu-e2e.cjs",
    "test:runtime-install": "tsx scripts/validate-speech-install.ts",
    "format": "prettier --write src scripts tests",
    "package": "npm run prepare:tools && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.5",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "beforePack": "./scripts/check-tools.cjs",
    "appId": "studio.raccoon.desktop",
    "productName": "Raccoon Studio",
    "compression": "store",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".tools/bundled-tools",
        "to": "tools",
        "filter": [
          "yt-dlp.exe",
          "yt-dlp-*.txt",
          "yt-dlp-*.LICENSE",
          "manifest.json",
          "whisper/**/*"
        ]
      },
      {
        "from": "scripts/whisperx_worker.py",
        "to": "workers/whisperx_worker.py"
      },
      {
        "from": "scripts/speech-runtime",
        "to": "workers/speech-runtime"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "tools/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "tools/ffmpeg.exe.LICENSE"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "tools/ffmpeg.exe.README"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "tools/ffprobe.exe"
      },
      {
        "from": "node_modules/ffprobe-static/LICENSE",
        "to": "tools/ffprobe-package.LICENSE"
      },
      {
        "from": "assets/Raccoon.ico",
        "to": "icons/Raccoon.ico"
      }
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "assets/Raccoon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
